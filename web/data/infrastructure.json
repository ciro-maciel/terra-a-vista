{"version":1,"vintage":{"roads":"Natural Earth v5.1.2 (1:10m)","rail":"Natural Earth v5.1.2 (1:10m)","ports":null,"airports":null},"sources":["natural_earth_roads"],"rules":{"roads":"Rodovias do Natural Earth 1:10m na Am\u00e9rica do Sul, amostradas a cada 4 km e encaixadas em liga\u00e7\u00f5es entre centros de hex\u00e1gonos, s\u00f3 em terra brasileira. Classe 0 (rodovia principal): as que o Natural Earth marca como Major Highway. Classe 1 (rodovia): as outras com escala at\u00e9 4, onde nenhuma principal j\u00e1 liga os mesmos dois hex\u00e1gonos.","rail":"Ferrovias do Natural Earth 1:10m com escala at\u00e9 7, amostradas a cada 4 km e encaixadas em liga\u00e7\u00f5es entre centros de hex\u00e1gonos; a linha principal tem escala at\u00e9 5. As linhas dos pa\u00edses vizinhos s\u00e3o cortadas. O Natural Earth n\u00e3o tem toda a malha ferrovi\u00e1ria, nem dono ou tr\u00e1fego.","ports":"Ainda n\u00e3o mapeados no Brasil: a movimenta\u00e7\u00e3o por porto (ANTAQ) entra numa pr\u00f3xima rodada.","airports":"Ainda n\u00e3o mapeados no Brasil: o movimento por aeroporto (ANAC) entra numa pr\u00f3xima rodada."},"road_classes":[{"id":"interstate","name":"Rodovia principal"},{"id":"major","name":"Rodovia"}],"rail_tiers":[{"id":"main","name":"Linha principal"},{"id":"secondary","name":"Linha secund\u00e1ria"}],"hubs":{"L":"Large hub","M":"Medium hub","S":"Small hub","N":"Nonhub primary"},"roads":[[964,1080,1,null],[1080,1197,1,null],[1197,1312,1,null],[1221,1337,1,null],[1312,1429,1,null],[1314,1315,1,null],[1314,1430,1,null],[1337,1454,1,null],[1430,1545,1,null],[1454,1569,1,null],[1544,1545,1,null],[1544,1661,1,null],[1569,1570,1,null],[1570,1687,1,null],[1661,1776,1,null],[1687,1802,1,null],[1776,1893,1,null],[1802,1919,1,null],[1893,2009,1,null],[1919,2034,1,null],[2009,2010,1,null],[2010,2126,1,null],[2034,2150,1,null],[2126,2241,1,null],[2150,2265,1,null],[2241,2357,1,null],[2265,2266,1,null],[2266,2382,1,null],[2357,2473,1,null],[2382,2498,1,null],[2473,2590,1,